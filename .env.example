# ---------------------------------------------------------------------------
# Copy to .env.local for development:  cp .env.example .env.local
# Everything here is OPTIONAL for local dev — the app runs with no config and
# keeps votes in memory. All of it is REQUIRED in production.
# ---------------------------------------------------------------------------

# Global vote counters (Upstash Redis, free tier, HTTPS REST API).
# Create a database at https://console.upstash.com and copy both values.
# Leave blank locally: votes fall back to an in-memory store that resets on
# restart, so percentages will look thin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC key that signs matchup vote tokens. Without it, anyone could forge a
# vote for an arbitrary pair of tracks. The app REFUSES TO START in production
# if this is missing or left at its development default.
#   openssl rand -base64 32
VOTE_SECRET=

# Salt for hashing client IPs before they're used as rate-limit keys. Raw IPs
# are never stored. Also required in production.
#   openssl rand -base64 32
IP_HASH_SALT=

# Canonical origin: share links, Open Graph metadata, and the domain printed
# onto result cards. Set this to the domain you want people to see — changing
# it is all that's needed after moving to a new one.
#
# On Vercel this falls back to the project's production domain, so cards never
# ship reading "localhost:3000" if it's forgotten. Set it explicitly anyway:
# a shared image outlives the deployment that made it.
NEXT_PUBLIC_SITE_URL=
